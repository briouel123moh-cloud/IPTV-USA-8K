---
import { planDurations, screenOptions } from '../data/plan-options.mjs';
const { lang='en' }=Astro.props;const fr=lang==='fr';
---
<section class="wrap quote-calculator" aria-labelledby="quote-calculator-title"><div><span class="eyebrow">{fr?'CALCULATEUR DE COÛT IPTV':'IPTV COST CALCULATOR'}</span><h2 id="quote-calculator-title">{fr?'Comparez le coût réel de votre devis IPTV':'Compare the real cost of your IPTV quote'}</h2><p>{fr?'Saisissez les montants d’un devis que vous avez reçu, taxes applicables comprises. Ajoutez seulement les frais qui ne sont pas déjà inclus. Cet outil ne fournit pas un prix IPTV USA 8K.':'Enter amounts from a quote you have received, including applicable taxes. Add only costs that are not already included. This tool does not provide a IPTV USA 8K price.'}</p></div><form data-cost-calculator data-lang={lang}><div class="quote-fields"><label>{fr?'Total de l’abonnement (USD)':'Subscription total (USD)'}<input type="number" name="quote" min="0.01" max="100000" step="0.01" required inputmode="decimal"/></label><label>{fr?'Autres frais de lecteur (USD)':'Additional player fees (USD)'}<input type="number" name="extras" min="0" max="100000" step="0.01" value="0" required inputmode="decimal"/></label><label>{fr?'Matériel ou installation (USD)':'Hardware or setup (USD)'}<input type="number" name="setup" min="0" max="100000" step="0.01" value="0" required inputmode="decimal"/></label><label>{fr?'Durée':'Duration'}<select name="months">{planDurations.map(n=><option value={n} selected={n===12}>{n} {fr?'mois':n===1?'month':'months'}</option>)}</select></label><label>{fr?'Écrans autorisés par le devis':'Screens allowed by the quote'}<select name="screens">{screenOptions.map(n=><option value={n}>{n}</option>)}</select></label></div><button type="submit" class="button" data-calculate-cost disabled>{fr?'Calculer le coût':'Calculate cost'} →</button><div class="quote-result" hidden aria-live="polite" aria-atomic="true"><dl><div><dt>{fr?'Total pour la période':'Total for the term'}</dt><dd data-total></dd></div><div><dt>{fr?'Équivalent mensuel':'Monthly equivalent'}</dt><dd data-monthly></dd></div><div><dt>{fr?'Par écran / mois':'Per screen / month'}</dt><dd data-screen></dd></div></dl><p>{fr?'Comparaison arithmétique seulement : ce résultat n’est pas une facturation mensuelle, une remise ni une confirmation de disponibilité.':'Arithmetic comparison only: this is not monthly billing, a discount or confirmation of availability.'}</p></div><p data-cost-error role="alert"></p><noscript><p>{fr?'Calcul manuel : additionnez les montants, puis divisez le total par le nombre de mois. Divisez encore par les écrans pour comparer le coût par écran.':'Manual calculation: add the amounts, then divide the total by the months. Divide again by screens to compare the per-screen cost.'}</p></noscript></form></section>
<script>
import { compareQuote } from '../lib/cost-comparison.mjs';
document.querySelectorAll<HTMLFormElement>('[data-cost-calculator]').forEach(form=>{
 const fr=form.dataset.lang==='fr', format=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});
 const result=form.querySelector<HTMLElement>('.quote-result')!,error=form.querySelector<HTMLElement>('[data-cost-error]')!;
 form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;try{const values=new FormData(form);const cost=compareQuote({quote:Number(values.get('quote')),extras:Number(values.get('extras')),setup:Number(values.get('setup')),months:Number(values.get('months')),screens:Number(values.get('screens'))});form.querySelector('[data-total]')!.textContent=format.format(cost.total);form.querySelector('[data-monthly]')!.textContent=format.format(cost.monthly);form.querySelector('[data-screen]')!.textContent=format.format(cost.monthlyPerScreen);error.textContent='';result.hidden=false;}catch{result.hidden=true;error.textContent=fr?'Vérifiez les montants, la durée et les écrans.':'Check the amounts, duration and screen count.';}});
 form.addEventListener('input',()=>{result.hidden=true;error.textContent='';});
 form.querySelector<HTMLButtonElement>('[data-calculate-cost]')!.disabled=false;
});
</script>
<style>
.quote-calculator{display:grid;grid-template-columns:1fr 1.35fr;gap:40px;padding-block:25px 55px}.quote-calculator h2{font-size:30px;line-height:1.25;margin:12px 0 20px}.quote-calculator>div>p{font-size:14px;line-height:1.8}.quote-calculator form{background:#f6f7fa;border:1px solid #e0e5ed;border-radius:16px;padding:28px}.quote-fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.quote-fields label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700}.quote-fields input,.quote-fields select{min-width:0;width:100%;padding:12px;border:1px solid #c8d0dd;border-radius:7px;background:white}.quote-calculator .button{margin-top:25px;cursor:pointer}.quote-result dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:28px}.quote-result dt{font-size:10px;line-height:1.6}.quote-result dd{font-size:23px;font-weight:800;margin-top:8px}.quote-result p{font-size:11px;line-height:1.7;margin-top:20px}[data-cost-error]{color:#aa2337;font-size:12px;margin-top:12px}@media(max-width:850px){.quote-calculator{grid-template-columns:1fr;gap:24px}}@media(max-width:520px){.quote-fields{grid-template-columns:1fr}.quote-calculator form{padding:23px}.quote-result dl{grid-template-columns:1fr}.quote-result dd{margin-top:3px}}
</style>
