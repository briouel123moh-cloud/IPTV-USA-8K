---
import { generator, generatorUrl } from '../data/generator.mjs';
const { lang='en' }=Astro.props;
const fr=lang==='fr';
const message=fr?'Bonjour, j’ai besoin d’aide pour mon essai IPTV USA 8K.':'Hi, I need help with my IPTV USA 8K trial.';
const requestUrl=`https://wa.me/${generator.sharedSupportNumber}?text=${encodeURIComponent(message)}`;
---
<section class="seven-day wrap" id="seven-day-trial" aria-labelledby="seven-day-heading">
  <div class="seven-day-badge" aria-hidden="true"><strong>7</strong><span>{fr?'JOURS':'DAYS'}</span></div>
  <div><span class="eyebrow">{fr?'GÉNÉREZ. TESTEZ. REVENEZ LE LENDEMAIN.':'GENERATE. TRY IT. RETURN THE NEXT DAY.'}</span><h2 id="seven-day-heading">{fr?'Essai IPTV USA de 7 jours : un accès à renouveler chaque jour':'7-day IPTV USA free trial: renew your access each day'}</h2><p>{fr?'Générez votre premier accès gratuit, puis revenez sur cette page après 24 heures pour demander le suivant. Vous pouvez demander jusqu’à 7 essais sur une période de 30 jours, avec les limites communes à notre réseau. Aucune carte bancaire et aucun abonnement automatique.':'Generate your first free access, then return to this page after 24 hours to request the next one. You can request up to 7 trials within 30 days, with limits shared across our network. No payment card and no automatic subscription.'}</p><p class="seven-day-note">{fr?'Le programme fonctionne avec des accès successifs, pas avec un seul identifiant valable sept jours sans interruption. Vérifiez l’expiration de chaque accès dans votre lecteur. Si une limite, une indisponibilité ou l’installation vous bloque, contactez-nous sur WhatsApp ou avec le chat.':'The program uses successive trial logins, rather than one login lasting seven uninterrupted days. Check each access expiry in your player. If a limit, availability issue or setup problem blocks you, contact us on WhatsApp or through live chat.'}</p><div class="seven-day-actions"><a class="button" href={generatorUrl(lang)} data-open-trial>{fr?'Générer ou renouveler mon essai':'Generate or renew my trial'} →</a><a class="text-link" href={requestUrl} target="_blank" rel="noopener noreferrer">{fr?'Aide WhatsApp pour mon essai':'WhatsApp help with my trial'} ↗</a></div></div>
</section>
<style>
.seven-day{display:grid;grid-template-columns:140px 1fr;gap:40px;padding-top:48px;padding-bottom:48px;border-bottom:1px solid var(--line)}.seven-day-badge{align-self:start;background:#fff0f2;border:1px solid #f2c9d0;border-radius:18px;text-align:center;padding:25px 12px;color:var(--red);font-family:var(--display)}.seven-day-badge strong{display:block;font-size:66px;line-height:1.1}.seven-day-badge span{font-size:11px;font-weight:800;letter-spacing:.16em}.seven-day .eyebrow{margin-bottom:12px}.seven-day h2{font-size:clamp(25px,2.6vw,35px);line-height:1.2;max-width:880px}.seven-day p{font-size:14px;line-height:1.8;margin-top:16px;max-width:900px}.seven-day .seven-day-note{font-size:12px;color:#646d7c}.seven-day-actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:23px}.seven-day-actions .button,.seven-day-actions .text-link{font-size:12px}@media(max-width:650px){.seven-day{grid-template-columns:1fr;gap:22px;padding-block:36px}.seven-day-badge{display:flex;align-items:center;gap:12px;width:max-content;padding:12px 20px}.seven-day-badge strong{font-size:35px}.seven-day h2{font-size:28px}.seven-day-actions{align-items:flex-start;flex-direction:column;gap:20px}.seven-day-actions .button{width:100%}}
</style>
