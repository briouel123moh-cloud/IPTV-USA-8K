---
const { small = false } = Astro.props;
---
<span class:list={['brand', { small }]}>
  <svg width="38" height="38" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect width="48" height="48" rx="13" fill="#112748"/><path d="M12 13h24v19H12z" stroke="#fff" stroke-width="2.1" stroke-linejoin="round"/><path d="m21 18 9 4.5-9 4.5V18Z" fill="#fff"/><path d="M18 37h12M24 32v5" stroke="#fff" stroke-width="2.1" stroke-linecap="round"/><path d="m37 4 2.1 4.3 4.8.7-3.5 3.3.9 4.7-4.3-2.3-4.3 2.3.9-4.7-3.5-3.3 4.8-.7L37 4Z" fill="#ee435b" stroke="#112748" stroke-width="1.1"/></svg>
  <span class="brand-wordmark"><span class="brand-name">IPTV USA <b>8K</b></span><span class="brand-country">LIVE TV · YOUR WAY</span></span>
</span>
<style>
.brand{gap:9px;letter-spacing:0}.brand svg{flex-shrink:0}.brand-wordmark{display:block}.brand-name{display:flex;align-items:center;gap:5px;font-size:21px;line-height:1.2;font-weight:850;letter-spacing:-.9px;white-space:nowrap;color:#112748}.brand-name b{font-size:14px;color:#fff;background:#d93650;padding:4px 5px;border-radius:5px;font-weight:850;letter-spacing:-.4px}.brand-country{font-size:7px;letter-spacing:2px;margin-top:6px;font-weight:750;color:#708099}.small .brand-name{font-size:19px}.small .brand-name b{font-size:12px}@media(max-width:520px){.brand-name{font-size:18px;gap:5px}.brand-name b{font-size:12px;padding:4px}.brand-country{font-size:6px;letter-spacing:1.6px}.brand svg{width:34px;height:34px}.brand{gap:8px}}
</style>
