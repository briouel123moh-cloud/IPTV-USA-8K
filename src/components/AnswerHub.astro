---
import { questionCategories, getQuestions } from '../data/questions';
import { href } from '../data/routes.mjs';
const { lang = 'en' } = Astro.props;
const fr = lang === 'fr';
const categories = questionCategories[lang as 'en' | 'fr'];
const questionCount = getQuestions(lang as 'en' | 'fr').length;
---
<section class="answer-hub wrap" data-answer-hub data-lang={lang} aria-labelledby="answer-hub-heading">
  <div class="answer-hub-intro"><span class="eyebrow">{fr?'VOS QUESTIONS IPTV, PAR THÈME':'YOUR IPTV QUESTIONS, BY TOPIC'}</span><h2 id="answer-hub-heading">{fr?'Les réponses pour choisir, installer et tester votre IPTV au United States':'Answers for choosing, setting up and testing IPTV in the USA'}</h2><p>{fr?`${questionCount} réponses sur les forfaits, les écrans, l’essai, les appareils et la télévision en français ou en anglais. Chaque réponse mène au guide ou à l’action utile.`:`${questionCount} answers about plans, screens, trials, devices and English or Spanish viewing. Each answer links to the relevant guide or next step.`}</p></div>
  <nav class="answer-category-jumps" aria-label={fr?'Thèmes des questions IPTV':'IPTV question topics'}>{categories.map(category=><a href={`#${category.id}`}>{category.title}<span aria-hidden="true">↘</span></a>)}</nav>
  <div class="answer-tools" data-answer-tools hidden>
    <div class="answer-search"><label for="answer-search-input">{fr?'Rechercher une question ou un mot':'Search a question or keyword'}</label><input id="answer-search-input" type="search" autocomplete="off" placeholder={fr?'Ex. : prix, Fire TV, 7 jours, écrans…':'Try: price, Fire TV, 7 days, screens…'} aria-controls="answer-results" data-answer-search/></div>
    <div class="answer-filter"><label for="answer-category-input">{fr?'Filtrer par thème':'Filter by topic'}</label><select id="answer-category-input" aria-controls="answer-results" data-answer-category><option value="all">{fr?'Tous les thèmes':'All topics'}</option>{categories.map(category=><option value={category.id}>{category.title}</option>)}</select></div>
    <button class="answer-reset" type="button" data-answer-reset>{fr?'Effacer les filtres':'Clear filters'}</button>
    <p class="answer-count" role="status" aria-live="polite" aria-atomic="true" data-answer-count>{fr?`${questionCount} réponses disponibles.`:`${questionCount} answers available.`}</p>
  </div>
  <div id="answer-results">
    {categories.map(category=><section class="answer-category" id={category.id} data-question-category={category.id} aria-labelledby={`${category.id}-heading`}><div class="answer-category-heading"><h2 id={`${category.id}-heading`}>{category.title}</h2><p>{category.intro}</p></div><div class="answer-list">{category.questions.map(question=><details id={question.id} class="answer-item" data-answer-item><summary><h3>{question.q}</h3><span class="answer-toggle" aria-hidden="true">+</span></summary><div class="answer-body"><p>{question.a}</p><div class="answer-links"><a href={href(question.link.route,lang)}>{question.link.label}<span aria-hidden="true">→</span></a><a class="answer-permalink" href={`#${question.id}`} aria-label={fr?`Lien direct : ${question.q}`:`Direct link: ${question.q}`}>{fr?'Lien direct':'Direct link'}</a></div>{question.source && <p class="answer-source">{fr?'Source de référence : ':'Reference: '}<a href={question.source.url}>{question.source.label} ↗</a></p>}</div></details>)}</div></section>)}
  </div>
  <div class="answer-empty" data-answer-empty hidden><h3>{fr?'Aucune réponse ne correspond à ces filtres.':'No answers match those filters.'}</h3><p>{fr?'Essayez un mot plus court, un autre thème ou effacez les filtres. Pour une question sur votre appareil ou votre accès, préparez une demande précise.':'Try a shorter term, another topic or clear the filters. For a question about your device or access, prepare a specific enquiry.'}</p><a class="text-link" href={href('contact',lang)}>{fr?'Préparer ma question':'Prepare my question'} →</a></div>
  <aside class="answer-next"><h2>{fr?'Vous avez votre réponse? Passez à votre installation.':'Found your answer? Take the next step with your setup.'}</h2><p>{fr?'Choisissez une configuration, vérifiez votre appareil et commencez par l’essai. Les tarifs et les conditions doivent être confirmés avant tout achat.':'Choose a configuration, check your device and start with the trial. Prices and terms must be confirmed before any purchase.'}</p><div><a class="button" href={href('plans',lang)}>{fr?'Comparer les forfaits':'Compare plan requests'} →</a><a class="text-link" href={href('trial',lang)}>{fr?'Découvrir l’essai gratuit':'Explore the free trial'} ↗</a></div></aside>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-answer-hub]').forEach(hub=>{
    const fr=hub.dataset.lang==='fr';
    const input=hub.querySelector<HTMLInputElement>('[data-answer-search]')!;
    const category=hub.querySelector<HTMLSelectElement>('[data-answer-category]')!;
    const counter=hub.querySelector<HTMLElement>('[data-answer-count]')!;
    const empty=hub.querySelector<HTMLElement>('[data-answer-empty]')!;
    const normalize=(text:string)=>text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase().replace(/[’'–—-]/g,' ').replace(/\b(seven|sept)\b/g,'7').replace(/\bfire\s+tv\s+stick\b/g,'firestick').replace(/\s+/g,' ').trim();
    const groups=Array.from(hub.querySelectorAll<HTMLElement>('[data-question-category]')).map(node=>({node,id:node.dataset.questionCategory,items:Array.from(node.querySelectorAll<HTMLDetailsElement>('[data-answer-item]')).map(item=>({node:item,text:normalize(item.textContent||'')}))}));
    const update=()=>{
      const terms=normalize(input.value).split(' ').filter(Boolean);
      let matches=0;
      groups.forEach(group=>{
        let visible=0;
        group.items.forEach(item=>{
          const match=(category.value==='all'||category.value===group.id)&&terms.every(term=>item.text.includes(term));
          item.node.hidden=!match;
          if(match){visible++;matches++;if(terms.length)item.node.open=true;}
        });
        group.node.hidden=visible===0;
      });
      counter.textContent=fr?`${matches} ${matches===1?'réponse correspond':'réponses correspondent'} à votre recherche.`:`${matches} ${matches===1?'answer matches':'answers match'} your search.`;
      empty.hidden=matches>0;
    };
    const reset=()=>{input.value='';category.value='all';update();};
    const revealHash=()=>{
      let id='';try{id=decodeURIComponent(window.location.hash.slice(1));}catch{return;}
      if(!id)return;
      const question=groups.flatMap(group=>group.items).find(item=>item.node.id===id);
      const group=groups.find(group=>group.id===id);
      if(question||group){reset();if(question)question.node.open=true;}
    };
    input.addEventListener('input',update);
    category.addEventListener('change',update);
    hub.querySelector('[data-answer-reset]')?.addEventListener('click',()=>{reset();input.focus();});
    hub.querySelectorAll<HTMLAnchorElement>('.answer-category-jumps a').forEach(link=>link.addEventListener('click',reset));
    window.addEventListener('hashchange',revealHash);
    hub.querySelector<HTMLElement>('[data-answer-tools]')!.hidden=false;
    revealHash();
  });
</script>
<style>
.answer-hub{padding-block:10px 65px}.answer-hub-intro{max-width:950px;margin-bottom:30px}.answer-hub h2{font-size:clamp(27px,3vw,39px);line-height:1.22;letter-spacing:-.035em}.answer-hub-intro>p{font-size:15px;line-height:1.85;margin-top:18px;max-width:880px}.answer-category-jumps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:26px}.answer-category-jumps a{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;background:#f5f6f8;border:1px solid #e0e4eb;border-radius:10px;font-size:12px;line-height:1.5;font-weight:750}.answer-category-jumps a:hover{color:#a82438;border-color:#b9243a}.answer-category-jumps a>span{font-size:18px;color:#b9243a;flex-shrink:0}.answer-tools{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) auto;align-items:end;gap:18px;background:#131a29;color:white;padding:26px;border-radius:14px;margin-bottom:42px}.answer-tools[hidden]{display:none}.answer-tools label{display:block;font-size:12px;font-weight:750;margin-bottom:9px}.answer-tools input,.answer-tools select{width:100%;min-width:0;min-height:47px;border:1px solid #d5dae5;border-radius:8px;background:#fff;color:#18212f;padding:10px 12px;font:inherit;font-size:13px}.answer-tools input:focus-visible,.answer-tools select:focus-visible,.answer-reset:focus-visible{outline:3px solid #ff9cab;outline-offset:3px}.answer-reset{min-height:47px;border:1px solid #697386;border-radius:8px;color:white;background:transparent;padding:10px 15px;font-size:12px;font-weight:750;cursor:pointer}.answer-reset:hover{background:#2c3546}.answer-count{grid-column:1/-1;color:#d7deeb;font-size:12px;margin:0;line-height:1.6}.answer-category{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:50px;padding-block:36px 46px;border-top:1px solid #e2e5ec;scroll-margin-top:100px}.answer-category[hidden],.answer-item[hidden],.answer-empty[hidden]{display:none}.answer-category-heading h2{font-size:27px;line-height:1.25;max-width:400px}.answer-category-heading>p{font-size:13px;line-height:1.8;margin-top:16px;color:#647083;max-width:400px}.answer-item{border-bottom:1px solid #e2e5ec;scroll-margin-top:100px}.answer-item:first-child{border-top:1px solid #e2e5ec}.answer-item summary{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;list-style:none;cursor:pointer;padding:20px 0}.answer-item summary::-webkit-details-marker{display:none}.answer-item summary:focus-visible{outline:3px solid #b9243a;outline-offset:3px;border-radius:3px}.answer-item summary h3{font-family:var(--font);font-size:15px;line-height:1.65;letter-spacing:0;font-weight:750}.answer-toggle{color:#b9243a;font-size:23px;font-weight:500;line-height:1.15;flex-shrink:0;transition:transform .15s}.answer-item[open] .answer-toggle{transform:rotate(45deg)}.answer-body{padding:0 0 23px}.answer-body>p{font-size:14px;line-height:1.9;color:#525f72}.answer-links{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:18px}.answer-links>a:first-child{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:750;color:#a42438;line-height:1.6}.answer-permalink{font-size:10px;white-space:nowrap;text-decoration:underline;text-underline-offset:3px;color:#697486}.answer-body>.answer-source{font-size:11px;line-height:1.8;margin-top:14px;color:#6a7382}.answer-source a{text-decoration:underline;text-underline-offset:3px}.answer-empty{background:#f5f6f8;padding:28px;border-radius:12px;margin:15px 0 35px}.answer-empty h3{font-size:23px;line-height:1.3}.answer-empty p{font-size:14px;line-height:1.8;margin-block:14px 18px}.answer-next{background:#f2f4f7;border-radius:16px;padding:35px 40px;margin-top:25px}.answer-next h2{font-size:29px;max-width:900px}.answer-next>p{font-size:14px;line-height:1.85;max-width:850px;margin-block:18px 24px}.answer-next>div{display:flex;align-items:center;flex-wrap:wrap;gap:25px}.answer-next .button,.answer-next .text-link{font-size:12px}@media(max-width:950px){.answer-category{grid-template-columns:1fr;gap:22px}.answer-category-heading h2,.answer-category-heading>p{max-width:850px}.answer-category-jumps{grid-template-columns:repeat(2,minmax(0,1fr))}.answer-tools{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.answer-reset{grid-column:1/-1;justify-self:start}.answer-count{grid-row:3;align-self:center;margin-left:155px}.answer-tools{row-gap:15px}}@media(max-width:600px){.answer-hub{padding-bottom:45px}.answer-hub-intro h2{font-size:29px}.answer-hub-intro>p{font-size:14px}.answer-category-jumps{grid-template-columns:1fr;gap:8px}.answer-category-jumps a{padding:14px 17px}.answer-tools{grid-template-columns:1fr;padding:22px 18px;gap:18px;margin-bottom:28px}.answer-reset{grid-column:1;justify-self:stretch}.answer-count{grid-row:auto;grid-column:1;margin-left:0}.answer-category{padding-block:28px 34px}.answer-category-heading h2{font-size:26px}.answer-item summary h3{font-size:14px}.answer-item summary{gap:16px}.answer-body>p{font-size:13px}.answer-links{align-items:flex-start;flex-direction:column;gap:14px}.answer-next{padding:27px 23px}.answer-next h2{font-size:26px}.answer-next>div{align-items:flex-start;flex-direction:column;gap:20px}.answer-next .button{width:100%}}
</style>
