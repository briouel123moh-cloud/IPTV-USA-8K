---
import { imageFor } from '../data/artwork.mjs';
import { copy } from '../data/copy';
import { searchMeta } from '../data/search-meta.mjs';
import { href } from '../data/routes.mjs';
import { guides } from '../data/guides';
import { generatorUrl } from '../data/generator.mjs';
import Faq from './Faq.astro';
import Plans from './Plans.astro';
import TrialGenerator from './TrialGenerator.astro';
import HomeCoverage from './HomeCoverage.astro';
import SevenDayTrial from './SevenDayTrial.astro';
const lang = 'en';
const t = copy.en;
const trial = generatorUrl(lang);
const hero = imageFor('dashboard', lang);
const heading = searchMeta.home.en.h1;
const divider = heading.indexOf(':');
const topic = divider >= 0 ? heading.slice(0, divider + 1) : 'IPTV USA';
const benefit = divider >= 0 ? heading.slice(divider + 1).trim() : heading.replace(/^IPTV USA\s*/i, '');
const steps = [
  ['Choose your device', 'Use the connection format supported by your app, Smart TV or MAG box.'],
  ['Generate your trial', 'Open the activation form, get your access and check the displayed expiration.'],
  ['Make it your TV night', 'Try your local feeds, sports, movies and English or Spanish audio on your own screen.'],
  ['Choose your subscription', 'Select your duration and screens. Confirm the complete USD quote before activation.']
];
---
<div class="sales-home">
  <div class="usa-offer-strip"><span>7-DAY IPTV USA TRIAL <i aria-hidden="true">·</i> RENEW DAILY</span><a href={trial} data-open-trial>Start your free trial <span aria-hidden="true">↗</span></a></div>
  <section class="usa-promo-hero">
    <div class="wrap usa-promo-inner">
      <div class="usa-hero-grid">
        <div class="usa-hero-copy">
          <span class="usa-hero-eyebrow"><span aria-hidden="true">★</span> YOUR NEXT TV NIGHT STARTS HERE</span>
          <h1><span>{topic}</span> {benefit}</h1>
          <p class="usa-promo-lead">Live TV, game nights, movies and series. Explore IPTV for your US household, try it on your own device, then choose a subscription that fits your screens.</p>
          <div class="usa-offer-actions"><a class="button usa-trial-button" href={trial} data-open-trial>Generate my free trial <span aria-hidden="true">→</span></a><a class="button usa-plan-button" href="#plans">Compare IPTV plans <span aria-hidden="true">↗</span></a></div>
          <div class="usa-proof-line"><span>No payment card</span><span>USD quotes</span><span>WhatsApp support</span></div>
          <p class="usa-hero-note">One new request after 24 hours, up to 7 in 30 days. Each trial has its own expiration. <a href="#seven-day-trial">See how it works</a></p>
        </div>
        <div class="usa-hero-visual">
          <div class="usa-screen-top"><span><i aria-hidden="true"></i> IPTV USA 8K</span><span>YOUR TV. YOUR WAY.</span></div>
          <figure class="usa-promo-art"><img src="/images/iptv-usa-8k-dashboard.webp" srcset="/images/iptv-usa-8k-dashboard-800.webp 800w, /images/iptv-usa-8k-dashboard.webp 1600w" sizes="(max-width: 900px) 100vw, 700px" width="1600" height="900" fetchpriority="high" alt={hero.alt} title={hero.title}/><figcaption>Illustrative artwork. Check specific channels and titles during your trial.</figcaption></figure>
          <div class="usa-screen-bottom"><span>LIVE TV</span><span>SPORTS</span><span>MOVIES + SERIES</span><a href={href('channels',lang)}>Build your watchlist <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
      <dl class="usa-promo-facts">
        <div><dt>Trial program · renew daily</dt><dd>7 days</dd></div>
        <div><dt>Choose your subscription length</dt><dd>1–24 months</dd></div>
        <div><dt>Compare simultaneous screens</dt><dd>1–6 screens</dd></div>
        <div><dt>Explore bilingual viewing</dt><dd>English + Spanish</dd></div>
      </dl>
    </div>
  </section>
  <nav class="page-jumps wrap" aria-label="On this page"><span>EXPLORE</span><a href="#plans">Subscriptions</a><a href="#free-trial">Free trial</a><a href={href('channels',lang)}>US channels</a><a href={href('sports',lang)}>Sports</a><a href={href('vod',lang)}>Movies & series</a><a href={href('devices',lang)}>Device setup</a></nav>
  <Plans lang={lang}/>
  <section class="usa-trial-intro"><div class="wrap usa-trial-intro-inner"><div><span class="eyebrow">TEST FIRST. CHOOSE WITH CONFIDENCE.</span><h2>Your IPTV USA free trial, on your screen.</h2></div><p>A channel name or a long feature list can only tell you so much. Use the trial to check the programs, picture, player and home connection you will actually use.</p></div></section>
  <TrialGenerator lang={lang}/>
  <SevenDayTrial lang={lang}/>
  <section class="wrap start-section"><div class="section-head"><span class="eyebrow">FROM FIRST CLICK TO TV NIGHT</span><h2>How to start your IPTV subscription in the USA</h2><p>Four straightforward steps, with support when you need it.</p></div><ol class="start-steps">{steps.map((step,i)=><li><span>0{i+1}</span><h3>{step[0]}</h3><p>{step[1]}</p></li>)}</ol></section>
  <HomeCoverage lang={lang}/>
  <Faq items={t.faq} heading="IPTV USA: questions before you subscribe"/>
  <div class="wrap all-answers-link"><a class="text-link" href={href('faq',lang)}>Explore all IPTV USA questions <span aria-hidden="true">→</span></a></div>
  <section class="wrap sales-guides"><div class="section-head"><span class="eyebrow">USEFUL ANSWERS. BETTER TV NIGHTS.</span><h2>Buying and setting up IPTV in the USA</h2><p>Find the right screen, compare the full cost and get more from your trial.</p></div><div class="sales-guide-grid">{guides.map((g,i)=><a class="sales-guide-card" href={href(g.id,lang)}><span class="guide-no">0{i+1} / {g.en.eyebrow}</span><h3>{g.en.heading}</h3><p>{g.en.description}</p><span class="text-link">{t.readGuide} <span aria-hidden="true">↗</span></span></a>)}</div></section>
  <section class="final-sales"><div class="wrap"><span class="eyebrow">IPTV USA 8K</span><h2>Big game. New series.<br/>Your kind of TV night.</h2><p>Try your setup. Find your favorites. Choose your plan.</p><div class="sales-actions"><a class="button" href={trial} data-open-trial>Generate my free trial <span aria-hidden="true">→</span></a><a class="button button-outline" href={href('plans',lang)}>Compare subscription plans</a></div></div></section>
</div>

<style>
.usa-offer-strip{display:flex;align-items:center;justify-content:center;gap:28px;padding:11px 24px;background:#fff1d5;color:#644012;font-size:11px;font-weight:800;letter-spacing:.04em}.usa-offer-strip i{font-style:normal;padding-inline:8px;color:#a77b35}.usa-offer-strip a{color:#a32239;text-decoration:underline;text-underline-offset:4px;white-space:nowrap}.usa-promo-hero{background:radial-gradient(ellipse at 94% 22%,#233e715c,transparent 60%),radial-gradient(ellipse at 5% 100%,#25395c50,transparent 55%),#080f20;color:#fff;overflow:hidden}.usa-promo-inner{max-width:1440px;padding-top:54px;padding-bottom:0}.usa-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:48px;align-items:center}.usa-hero-copy{padding-bottom:25px;min-width:0}.usa-hero-eyebrow{display:flex;align-items:center;gap:9px;font-size:10px;letter-spacing:.12em;font-weight:800;color:#9eafcf;margin-bottom:23px}.usa-hero-eyebrow>span{font-size:17px;color:#ffcf79}.usa-promo-hero h1{font-size:clamp(38px,4vw,57px);font-weight:850;line-height:1.12;letter-spacing:-.045em;max-width:650px;margin:0 0 23px;text-wrap:balance}.usa-promo-hero h1>span{color:#ff7887}.usa-promo-lead{font-size:16px;line-height:1.8;color:#c1cbde;max-width:540px;margin:0}.usa-offer-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.usa-offer-actions .button{min-height:52px;padding:14px 18px;font-size:13px;justify-content:center;gap:14px}.usa-trial-button{background:#f7c96f;color:#251a0a;border-color:#f7c96f;box-shadow:0 8px 30px #f7c96f12}.usa-trial-button:hover{background:#ffe0a0;border-color:#ffe0a0;color:#251a0a}.usa-plan-button{background:#ffffff05;color:#fff;border-color:#697b9b80}.usa-plan-button:hover{background:#ffffff12;border-color:#91a5c9;color:#fff}.usa-proof-line{display:flex;gap:9px 17px;flex-wrap:wrap;margin-top:21px;color:#c7d1e2;font-size:11px;font-weight:650}.usa-proof-line span:before{content:'✓';color:#ffce77;margin-right:6px}.usa-hero-note{font-size:10px;line-height:1.8;color:#8f9db5;max-width:510px;margin-top:18px}.usa-hero-note a{color:#c8d8f2;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}.usa-hero-visual{min-width:0;border:1px solid #51678770;border-radius:17px;overflow:hidden;background:#0d172c;box-shadow:0 20px 80px #0005,0 0 65px #1d4a9820}.usa-screen-top{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:15px 18px;background:#ffffff03;font-size:9px;letter-spacing:.08em;color:#93a7c7;font-weight:700}.usa-screen-top>span:first-child{display:flex;align-items:center;gap:8px;color:#e2e9f6;font-size:10px}.usa-screen-top i{height:6px;width:6px;border-radius:50%;background:#ed4b62;box-shadow:0 0 11px #ed4b6260}.usa-promo-art{margin:0;background:#0b1326}.usa-promo-art img{width:100%;height:auto;aspect-ratio:16/9;display:block}.usa-promo-art figcaption{font-size:9px;color:#7f94b5;text-align:center;padding:10px 15px;line-height:1.6;border-top:1px solid #ffffff0b}.usa-screen-bottom{display:flex;align-items:center;gap:16px;padding:15px 17px;border-top:1px solid #ffffff0d;color:#adbdd6;font-size:8px;font-weight:750;letter-spacing:.03em}.usa-screen-bottom>a{margin-left:auto;color:#f6cb7b;font-size:9px;letter-spacing:0}.usa-promo-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin:34px 0 0;padding:27px 0 29px;border-top:1px solid #ffffff1a}.usa-promo-facts>div{display:flex;flex-direction:column-reverse;gap:5px;min-width:0;padding-left:25px;border-left:1px solid #ffffff16}.usa-promo-facts>div:first-child{padding-left:0;border:0}.usa-promo-facts dt{font-size:10px;color:#8e9fbb;line-height:1.5}.usa-promo-facts dd{font-size:22px;line-height:1.25;font-weight:800;margin:0;color:#edf2fc;letter-spacing:-.025em}.usa-trial-intro{background:#f3f6fb;border-block:1px solid #e1e7f0}.usa-trial-intro-inner{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;padding-top:40px;padding-bottom:42px}.usa-trial-intro h2{font-size:31px;line-height:1.2;max-width:550px}.usa-trial-intro .eyebrow{margin-bottom:13px;font-size:10px}.usa-trial-intro p{font-size:15px;line-height:1.8;max-width:500px;color:#5e6b80}.sales-home .final-sales{background:radial-gradient(ellipse at 80% 10%,#1d3969,transparent 65%),#0b152a}.sales-home .final-sales .button:not(.button-outline){background:#f7c96f;border-color:#f7c96f;color:#251a0a}.sales-home .final-sales .eyebrow{color:#9fb7dc}.sales-home .final-sales h2{font-size:clamp(34px,4vw,48px)}
@media(max-width:1150px){.usa-hero-grid{gap:30px;grid-template-columns:1fr 1fr}.usa-promo-hero h1{font-size:43px}.usa-offer-actions{gap:10px}.usa-offer-actions .button{font-size:11px;padding:12px 14px;min-height:48px}.usa-screen-bottom{gap:10px;font-size:7px;padding-inline:12px}.usa-screen-bottom>a{font-size:8px}.usa-promo-facts dd{font-size:20px}}
@media(max-width:900px){.usa-promo-inner{padding-top:35px}.usa-hero-grid{grid-template-columns:1fr;gap:26px}.usa-hero-copy{max-width:730px;padding:0}.usa-promo-hero h1{font-size:clamp(40px,6.5vw,56px);max-width:720px}.usa-promo-lead{max-width:650px;font-size:16px}.usa-offer-actions .button{font-size:13px;padding:14px 20px}.usa-hero-visual{width:100%;max-width:800px;margin:auto}.usa-hero-note{max-width:670px}.usa-promo-facts{gap:14px;margin-top:30px}.usa-promo-facts>div{padding-left:14px}.usa-promo-facts dd{font-size:20px}.usa-promo-facts dt{font-size:9px}.usa-trial-intro-inner{gap:30px}.usa-trial-intro h2{font-size:28px}.usa-trial-intro p{font-size:14px}}
@media(max-width:520px){.usa-offer-strip{padding:10px 18px;gap:6px;flex-direction:column;text-align:center;font-size:9px}.usa-offer-strip a{font-size:10px}.usa-promo-inner{padding-top:28px}.usa-hero-eyebrow{font-size:8px;margin-bottom:18px;gap:7px}.usa-hero-eyebrow>span{font-size:14px}.usa-promo-hero h1{font-size:38px;line-height:1.14;letter-spacing:-.045em;margin-bottom:19px;text-wrap:initial}.usa-promo-lead{font-size:14px;line-height:1.8}.usa-offer-actions{flex-direction:column;gap:10px;margin-top:23px}.usa-offer-actions .button{width:100%;font-size:13px;min-height:50px;padding-inline:12px}.usa-proof-line{gap:7px 12px;font-size:9px;justify-content:center;margin-top:18px}.usa-hero-note{font-size:9px;text-align:center;margin-top:15px}.usa-hero-grid{gap:23px}.usa-hero-visual{border-radius:12px}.usa-screen-top{padding:12px 13px;font-size:7px}.usa-screen-top>span:first-child{font-size:8px}.usa-screen-bottom{gap:11px;flex-wrap:wrap;padding:12px 13px;font-size:7px}.usa-screen-bottom>a{font-size:8px;white-space:nowrap}.usa-promo-art figcaption{font-size:8px;padding:9px 12px}.usa-promo-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 14px;margin-top:26px;padding-block:25px}.usa-promo-facts>div{padding-left:0;border:0}.usa-promo-facts dd{font-size:20px}.usa-promo-facts dt{font-size:9px}.usa-trial-intro-inner{grid-template-columns:1fr;gap:20px;padding-block:30px}.usa-trial-intro h2{font-size:28px}.usa-trial-intro p{font-size:14px}.sales-home .final-sales h2{font-size:34px}}
</style>
