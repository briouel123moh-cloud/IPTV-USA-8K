---
import { site } from '../data/site.mjs';
import { href } from '../data/routes.mjs';
import { generator, generatorUrl } from '../data/generator.mjs';
import { screenOptions, planCopy } from '../data/plan-options.mjs';
import { planWhatsAppUrl } from '../lib/plan-request.mjs';
const { lang='en' }=Astro.props;
const fr=lang==='fr';
const supportPhone=site.phone || generator.sharedSupportNumber;
const perks=fr?['Essai gratuit avant l’achat','7 durées d’abonnement','Assistance WhatsApp','USD quotes']:['Free trial before you buy','7 subscription lengths','WhatsApp support','USD quotes'];
const features=fr?['Essai gratuit sur votre appareil','Choix d’écrans pour votre foyer','Aide à l’installation','Assistance sur WhatsApp']:['Free trial on your device','Screen options for your household','Help with your setup','WhatsApp support'];
---
<section class="plans-section wrap" id="plans" aria-labelledby="plans-heading">
  <div class="section-head centered pricing-intro">
    <span class="eyebrow">{fr?'VOTRE TÉLÉ. VOS ÉCRANS. VOTRE FORFAIT.':'YOUR TV. YOUR SCREENS. YOUR PLAN.'}</span>
    <h2 id="plans-heading">{fr?'IPTV USA : forfaits et tarifs':'IPTV USA Plans & Pricing'}</h2>
    <p>{fr?'De 1 à 24 mois, seul ou à plusieurs. Choisissez vos écrans, trouvez votre durée et obtenez votre tarif USD directement sur WhatsApp.':'From 1 to 24 months, for one screen or the whole household. Choose your screens, pick your duration and get your USD quote directly on WhatsApp.'}</p>
    <ul class="pricing-perks">{perks.map(perk=><li><span aria-hidden="true">✓</span>{perk}</li>)}</ul>
  </div>
  <div class="plan-configurator" data-plan-configurator data-lang={lang} data-phone={supportPhone}>
    <fieldset class="screen-picker" disabled>
      <legend>{fr?'Combien d’écrans souhaitez-vous?':'How many screens do you need?'}</legend>
      <div class="screen-options">{screenOptions.map(n=><label><input type="radio" name="screens" value={n} checked={n===1}/><span><strong>{n}</strong><small>{fr?(n===1?'écran':'écrans'):(n===1?'screen':'screens')}</small></span></label>)}</div>
      <div class="screen-selection" aria-live="polite" aria-atomic="true" data-screen-summary>{fr?'1 écran simultané · Choisissez votre durée.':'1 simultaneous screen · Choose your duration.'}</div>
    </fieldset>
    <noscript><p class="plan-no-script">{fr?'Les cartes ouvrent WhatsApp pour 1 écran. Le tableau propose les 42 configurations sans JavaScript.':'Cards open WhatsApp for 1 screen. The table offers all 42 configurations without JavaScript.'} <a href={href('plans',lang)+'#plan-comparison'}>{fr?'Choisir dans le tableau':'Choose from the table'} →</a></p></noscript>
    <div class="sales-plans-grid expanded-plan-grid">
      {site.plans.map(plan=><article class:list={['sales-plan',{'plan-highlight':plan.months===12}]}>
        {plan.months===12 && <span class="annual-plan-badge">{fr?'FORFAIT ANNUEL':'ANNUAL PLAN'}</span>}
        <div class="plan-card-heading">
          <span class="plan-label">{planCopy[lang][plan.months][0]}</span>
          <h3>{plan.months}{' '}<span>{fr?'mois':plan.months===1?'month':'months'}</span></h3>
          <p class="sales-plan-detail">{planCopy[lang][plan.months][1]}</p>
          <div class="sales-plan-price"><strong>USD</strong><span>{fr?'Votre tarif personnalisé':'Your personal quote'}</span></div>
          <div class="plan-screen-badge" data-card-screens>{fr?'1 écran simultané':'1 simultaneous screen'}</div>
        </div>
        <ul class="plan-benefits">{features.map(feature=><li><span aria-hidden="true">✓</span>{feature}</li>)}</ul>
        <a class="button" href={planWhatsAppUrl(lang,plan.months,1,supportPhone)} data-plan-whatsapp data-months={plan.months} aria-label={fr?`Demander ${plan.months} mois pour 1 écran sur WhatsApp`:`Request ${plan.months} ${plan.months===1?'month':'months'} for 1 screen on WhatsApp`}>{fr?'Choisir sur WhatsApp':'Choose on WhatsApp'} <span aria-hidden="true">↗</span></a>
        <a class="plan-trial-link" href={generatorUrl(lang)} data-open-trial>{fr?'Tester gratuitement d’abord':'Try it free first'} <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </div>
  <p class="plans-disclosure">{fr?'Le tarif USD, les taxes et les connexions disponibles sont confirmés avant activation. Le nombre d’écrans choisi concerne l’abonnement, pas l’essai.':'Your USD total, taxes and available connections are confirmed before activation. Screen selection applies to the subscription, not the trial.'} <a href={href('plans',lang)+'#plan-comparison'}>{fr?'Comparer les 42 configurations':'Compare all 42 configurations'} →</a></p>
  <div class="custom-plan-card">
    <div><span class="eyebrow">{fr?'UN FORFAIT À VOTRE MESURE':'A PLAN BUILT AROUND YOU'}</span><h3>{fr?'7 écrans ou plus? Une autre durée?':'Need 7+ screens or a different duration?'}</h3><p>{fr?'Décrivez votre installation et vos habitudes. L’équipe vous aide à choisir les connexions et la durée qui vous conviennent.':'Tell us about your setup and viewing routine. The team will help you choose the right connections and subscription length.'}</p></div>
    <a class="button button-outline" href={planWhatsAppUrl(lang,'custom','7+',supportPhone)}>{fr?'Obtenir mon devis':'Get my custom quote'} <span aria-hidden="true">→</span></a>
  </div>
</section>
<script>
  import { planWhatsAppUrl } from '../lib/plan-request.mjs';
  document.querySelectorAll<HTMLElement>('[data-plan-configurator]').forEach(form=>{
    const fr=form.dataset.lang==='fr';
    const update=()=>{
      const chosen=form.querySelector<HTMLInputElement>('input[name="screens"]:checked')?.value || '1';
      const singular=chosen==='1';
      form.querySelectorAll<HTMLAnchorElement>('[data-plan-whatsapp]').forEach(link=>{
        link.href=planWhatsAppUrl(fr?'fr':'en',link.dataset.months,chosen,form.dataset.phone);
        link.setAttribute('aria-label',fr?`Demander ${link.dataset.months} mois pour ${chosen} ${singular?'écran':'écrans'} sur WhatsApp`:`Request ${link.dataset.months} ${link.dataset.months==='1'?'month':'months'} for ${chosen} ${singular?'screen':'screens'} on WhatsApp`);
      });
      form.querySelectorAll<HTMLElement>('[data-card-screens]').forEach(el=>{el.textContent=fr?`${chosen} ${singular?'écran simultané':'écrans simultanés'}`:`${chosen} simultaneous ${singular?'screen':'screens'}`;});
      const summary=form.querySelector<HTMLElement>('[data-screen-summary]');
      if(summary)summary.textContent=fr?`${chosen} ${singular?'écran simultané':'écrans simultanés'} · Choisissez votre durée.`:`${chosen} simultaneous ${singular?'screen':'screens'} · Choose your duration.`;
    };
    form.addEventListener('change',update); update();
    form.querySelector<HTMLFieldSetElement>('.screen-picker')!.disabled=false;
  });
</script>
<style>
.plans-section{padding-block:88px 78px;scroll-margin-top:25px}.pricing-intro{max-width:930px;margin:0 auto 38px;text-align:center}.pricing-intro .eyebrow{font-size:11px;letter-spacing:.13em;font-weight:800;color:#b4233a;margin-bottom:15px}.pricing-intro h2{font-size:clamp(34px,4vw,48px);font-weight:850;letter-spacing:-.045em;line-height:1.13;color:#141d2c}.pricing-intro>p{font-size:16px;line-height:1.8;max-width:790px;margin:20px auto 0;color:#617085}.pricing-perks{list-style:none;display:flex;justify-content:center;flex-wrap:wrap;gap:10px 14px;margin:25px 0 0;padding:0}.pricing-perks li{display:flex;gap:7px;align-items:center;padding:7px 12px;background:#fff0f2;border:1px solid #f2d7dc;color:#8f2032;border-radius:999px;font-size:12px;font-weight:700;margin:0}.pricing-perks li>span{font-weight:900}.screen-picker{max-width:720px;border:0;border-radius:0;background:transparent;padding:0;margin:0 auto 39px;text-align:center;min-width:0}.screen-picker legend{width:100%;padding:0;margin-bottom:15px;text-align:center;font-size:18px;line-height:1.4;font-weight:800;color:#263347}.screen-options{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px;padding:7px;background:#edf0f5;border:1px solid #e2e6ed;border-radius:16px}.screen-options label{position:relative;cursor:pointer;min-width:0}.screen-options input{position:absolute;opacity:0;width:100%;height:100%;inset:0;cursor:pointer;margin:0}.screen-options label>span{display:flex;justify-content:center;align-items:baseline;gap:5px;padding:13px 5px;min-height:54px;background:#fff;border:1px solid #e2e6ed;border-radius:11px;color:#506078;transition:background .18s,box-shadow .18s}.screen-options strong{font-size:20px;line-height:1.2;font-weight:850}.screen-options small{font-size:11px;font-weight:650}.screen-options input:checked+span{background:linear-gradient(125deg,#c92e46,#9d1b33);border-color:#b8243c;color:#fff;box-shadow:0 4px 12px #a31e3330}.screen-options input:focus-visible+span{outline:3px solid #263d61;outline-offset:3px}.screen-selection{font-size:13px;line-height:1.5;color:#66748a;margin-top:13px;font-weight:500}.plan-no-script{font-size:13px;line-height:1.8;margin:0 auto 25px;max-width:760px;text-align:center}.plan-no-script a{color:#a72036;text-decoration:underline}.expanded-plan-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:29px 22px;margin-top:0;align-items:stretch}.expanded-plan-grid .sales-plan{position:relative;display:flex;flex-direction:column;min-width:0;padding:30px 23px 25px;border:1px solid #dee3ec;border-radius:19px;background:#fff;box-shadow:0 8px 28px #24374b09;color:#243044;transition:box-shadow .18s,transform .18s}.expanded-plan-grid .sales-plan:hover{box-shadow:0 14px 34px #24374b17;transform:translateY(-3px)}.plan-card-heading{text-align:center}.sales-plan .plan-label{display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#69788d;line-height:1.5}.sales-plan h3{font-size:34px;font-weight:850;letter-spacing:-.04em;color:#192337;line-height:1.2;margin:12px 0 0}.sales-plan h3>span{font-size:27px;color:inherit;letter-spacing:inherit;margin-left:0}.sales-plan .sales-plan-detail{font-size:13px;line-height:1.65;min-height:43px;margin:12px 0 0;color:#738095}.sales-plan .sales-plan-price{border:0;margin:20px 0 12px;padding:0}.sales-plan .sales-plan-price strong{display:block;font-size:47px;line-height:1.05;letter-spacing:-.045em;font-weight:850;color:#bd263e}.sales-plan .sales-plan-price>span{display:block;font-size:13px;font-weight:650;line-height:1.5;margin-top:8px;color:#68758b}.plan-screen-badge{display:inline-flex;justify-content:center;align-items:center;align-self:auto;background:#f2f5f9;color:#4f6078;border:1px solid #e4e9f0;border-radius:999px;padding:5px 11px;font-size:11px;line-height:1.4;font-weight:700;margin:0}.sales-plan .plan-benefits{list-style:none;padding:23px 0 0;margin:22px 0 26px;border-top:1px solid #e6eaf0;flex:1}.sales-plan .plan-benefits li{display:flex;gap:10px;align-items:flex-start;font-size:13px;line-height:1.65;font-weight:500;color:#5d6b80;margin:0}.sales-plan .plan-benefits li+li{margin-top:12px}.sales-plan .plan-benefits li:before{content:none}.plan-benefits li>span{color:#be2a40;font-weight:900;font-size:14px;flex:0 0 13px}.expanded-plan-grid .sales-plan>.button{display:flex;width:100%;margin-top:auto;min-height:50px;border-radius:9px;border:1px solid #bb253d;background:linear-gradient(125deg,#c82d45,#ac2038);color:#fff;font-size:13px;font-weight:800;padding:12px 10px;gap:9px;white-space:normal;line-height:1.4;text-align:center}.expanded-plan-grid .sales-plan>.button:hover{background:#991a30;border-color:#991a30;transform:none;box-shadow:0 5px 15px #a51d3224}.expanded-plan-grid .sales-plan>.button>span{font-size:16px}.plan-trial-link{display:flex;justify-content:center;align-items:center;gap:8px;font-size:12px;font-weight:700;line-height:1.5;text-align:center;color:#66748a;text-decoration:none;margin-top:16px}.plan-trial-link:hover{color:#ab2038;text-decoration:underline;text-underline-offset:3px}.expanded-plan-grid .plan-highlight{background:linear-gradient(145deg,#ce2e49 0%,#b11e38 56%,#871529 100%);border-color:#b5213a;color:#fff;box-shadow:0 12px 32px #aa203329;outline:3px solid #efc8d0;outline-offset:0}.annual-plan-badge{position:absolute;left:50%;top:-13px;transform:translateX(-50%);background:#fff0d3;color:#703314;border:1px solid #f4d8a2;border-radius:999px;font-size:10px;line-height:1.4;font-weight:900;letter-spacing:.08em;white-space:nowrap;padding:6px 14px;box-shadow:0 2px 7px #6c152125}.plan-highlight .plan-label,.plan-highlight h3,.plan-highlight h3>span,.plan-highlight .sales-plan-price strong{color:#fff}.plan-highlight .sales-plan-detail,.plan-highlight .sales-plan-price>span,.plan-highlight .plan-benefits li{color:#ffe3e9}.plan-highlight .plan-screen-badge{background:#ffffff16;border-color:#ffffff2b;color:#fff}.plan-highlight .plan-benefits{border-color:#ffffff33}.plan-highlight .plan-benefits li>span{color:#fff}.expanded-plan-grid .plan-highlight>.button{background:#fff;border-color:#fff;color:#a11d34;box-shadow:0 4px 12px #6811221a}.expanded-plan-grid .plan-highlight>.button:hover{background:#fff0f3;border-color:#fff0f3;color:#85152a;box-shadow:0 5px 18px #68112233}.plan-highlight .plan-trial-link{color:#fff3f6}.plan-highlight .plan-trial-link:hover{color:#fff}.plans-disclosure{font-size:12px;line-height:1.85;color:#748196;max-width:900px;text-align:center;margin:26px auto 0}.plans-disclosure a{display:inline-block;color:#a82138;font-weight:700;text-decoration:underline;text-underline-offset:3px;margin-left:4px}.custom-plan-card{display:flex;align-items:center;justify-content:space-between;gap:36px;background:linear-gradient(110deg,#111c2c 0%,#381d2b 58%,#171d30 100%);border:1px solid #263347;border-radius:23px;box-shadow:0 12px 35px #15213217;padding:39px 40px;margin-top:43px;color:#fff}.custom-plan-card>div{min-width:0;max-width:760px}.custom-plan-card .eyebrow{display:inline-block;padding:6px 10px;background:#ffffff12;border:1px solid #ffffff20;border-radius:999px;font-size:10px;letter-spacing:.08em;color:#ffc3cf;font-weight:750;margin:0 0 15px}.custom-plan-card h3{font-size:30px;line-height:1.22;font-weight:850;letter-spacing:-.035em;color:#fff;margin:0}.custom-plan-card p{font-size:14px;line-height:1.8;max-width:700px;color:#d5d9e4;margin-top:14px}.custom-plan-card>.button.button-outline{display:flex;flex:0 0 auto;justify-content:center;align-items:center;gap:17px;min-height:54px;max-width:270px;padding:14px 22px;border-radius:9px;background:#fff;border:1px solid #fff;color:#17253a;font-size:14px;font-weight:850;line-height:1.4;white-space:normal;text-align:center;box-shadow:0 5px 16px #060b1520}.custom-plan-card>.button.button-outline:hover{background:#ffeef2;border-color:#ffeef2;color:#8e1930;transform:none}.custom-plan-card>.button>span{font-size:18px}@media(max-width:1100px){.expanded-plan-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:27px 24px}.expanded-plan-grid .sales-plan{padding:31px 28px 26px}.sales-plan .sales-plan-detail{min-height:43px}.sales-plan .plan-benefits li{font-size:14px}.expanded-plan-grid .sales-plan>.button{font-size:14px}.custom-plan-card{align-items:flex-start;flex-direction:column;gap:25px}.custom-plan-card>.button.button-outline{max-width:none}.custom-plan-card h3{font-size:29px}}@media(max-width:600px){.plans-section{padding-block:59px 48px}.pricing-intro{margin-bottom:30px}.pricing-intro .eyebrow{font-size:9px;letter-spacing:.1em}.pricing-intro h2{font-size:35px;line-height:1.14}.pricing-intro>p{font-size:14px;line-height:1.8;margin-top:17px}.pricing-perks{gap:8px;margin-top:21px}.pricing-perks li{font-size:10px;padding:6px 9px;gap:5px}.screen-picker{margin-bottom:31px}.screen-picker legend{font-size:16px;margin-bottom:12px}.screen-options{gap:5px;padding:6px;border-radius:13px}.screen-options label>span{flex-direction:column;align-items:center;gap:4px;min-height:58px;padding:9px 2px;border-radius:9px}.screen-options strong{font-size:19px}.screen-options small{font-size:9px}.screen-selection{font-size:11px;margin-top:11px}.expanded-plan-grid{grid-template-columns:1fr;gap:27px}.expanded-plan-grid .sales-plan{padding:29px 27px 25px;border-radius:17px}.sales-plan .plan-label{font-size:11px}.sales-plan h3{font-size:36px}.sales-plan h3>span{font-size:29px}.sales-plan .sales-plan-detail{font-size:14px;min-height:0;max-width:290px;margin-inline:auto}.sales-plan .sales-plan-price strong{font-size:49px}.sales-plan .sales-plan-price>span{font-size:14px}.plan-screen-badge{font-size:12px}.sales-plan .plan-benefits{padding-top:23px;margin-top:23px}.sales-plan .plan-benefits li{font-size:14px}.expanded-plan-grid .sales-plan>.button{font-size:14px;min-height:52px}.plan-trial-link{font-size:13px}.plans-disclosure{font-size:11px;line-height:1.9;margin-top:23px}.plans-disclosure a{display:block;margin:7px 0 0}.custom-plan-card{padding:29px 25px;margin-top:31px;border-radius:18px;gap:24px}.custom-plan-card .eyebrow{font-size:8px;letter-spacing:.05em}.custom-plan-card h3{font-size:27px;line-height:1.25}.custom-plan-card p{font-size:13px;line-height:1.9}.custom-plan-card>.button.button-outline{width:100%;font-size:14px;min-height:52px}}
