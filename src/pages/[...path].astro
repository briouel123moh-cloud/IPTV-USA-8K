---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import Faq from '../components/Faq.astro';
import AnswerHub from '../components/AnswerHub.astro';
import TopicLinks from '../components/TopicLinks.astro';
import CostCalculator from '../components/CostCalculator.astro';
import DeviceChooser from '../components/DeviceChooser.astro';
import Contact from '../components/Contact.astro';
import Plans from '../components/Plans.astro';
import PlanComparison from '../components/PlanComparison.astro';
import TrialGenerator from '../components/TrialGenerator.astro';
import SevenDayTrial from '../components/SevenDayTrial.astro';
import Privacy from '../components/Privacy.astro';
import CatalogPages from '../components/CatalogPages.astro';
import { catalog } from '../data/catalog';
import { generatorUrl, generatorSupportUrl } from '../data/generator.mjs';
import { routes, href } from '../data/routes.mjs';
import { copy } from '../data/copy';
import { site } from '../data/site.mjs';
import { searchMeta } from '../data/search-meta.mjs';
import { guides } from '../data/guides';
export function getStaticPaths() { return routes.filter(route=>route.id!=='home').map(route=>({params:{path:route.path.slice(1,-1)},props:route})); }
const {id,lang} = Astro.props;
const fr=lang==='fr'; const t=copy[lang];
const reviewedDate = new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeZone:'UTC'}).format(new Date(`${site.updated}T00:00:00Z`));
const catalogPage = catalog[id]?.[lang];
const guide=guides.find(g=>g.id===id); const article=guide?.[lang];
const { title, description, h1 } = searchMeta[id][lang];
const intro={
  plans:fr?'Un mois pour découvrir, une durée plus longue pour vos habitudes. Commencez par le nombre d’écrans et les programmes qui comptent pour vous.':'A month to explore. A longer term for your routine. Start with the screens and programs that matter to you.',
  devices:fr?'Pas besoin de deviner. Choisissez votre appareil pour connaître les vérifications utiles avant de vous abonner.':'No guesswork needed. Choose your device and see what to check before subscribing.',
  guides:fr?'Des conseils pratiques pour comprendre l’IPTV au United States et choisir sans vous perdre dans les détails.':'Practical guidance for understanding IPTV in the United States and choosing without getting lost in the details.',
  trial:fr?'Testez à la maison, sur votre appareil, aux heures où vous regardez vraiment. Voici comment tirer le maximum d’un essai.':'Test at home, on your device, at the time you actually watch. Here is how to get the most from a trial.',
  contact:fr?'Contactez l’équipe partagée sur WhatsApp pour votre essai, votre installation ou un devis d’abonnement au United States.':'Contact the shared team on WhatsApp for your trial, setup or an IPTV USA subscription quote.',
  faq:fr?'L’essentiel sur les abonnements, les appareils et la télévision par Internet au United States.':'The essentials on subscriptions, devices and internet television in the United States.',
  about:fr?'IPTV USA 8K vous aide à tester et à choisir votre IPTV au United States, avec des pages en français et en anglais.':'IPTV USA 8K helps you test and choose IPTV for the United States, with practical guides for US households.',
  privacy:fr?'Le site, le générateur d’essai et vos renseignements. Mise à jour : 1er novembre 2026.':'The website, the trial generator and your information. Updated 1 November 2026.',
  terms:fr?'Ces conditions concernent l’utilisation du site. Mise à jour : 1er novembre 2026.':'These terms cover use of this website. Updated 1 November 2026.'
};
---
<Base lang={lang} id={id} title={title} description={description} isArticle={Boolean(article)}>
{id === 'home' ? <Home lang={lang}/> : <>
  <div class="wrap breadcrumbs"><a href={href('home',lang)}>{t.home}</a><span aria-hidden="true">/</span>{article && <><a href={href('guides',lang)}>{fr?'Guides':'Guides'}</a><span aria-hidden="true">/</span></>}<span>{catalogPage?(fr?'Catalogue IPTV':'IPTV catalogue'):article?article.eyebrow:({plans:t.nav[0],devices:t.nav[1],guides:t.nav[2],trial:fr?'Essai':'Trial',contact:t.contact,faq:'FAQ',about:t.legal[0],privacy:t.legal[1],terms:t.legal[2]})[id]}</span></div>
  <section class="page-heading wrap"><span class="eyebrow">{article?article.eyebrow:'IPTV USA 8K · UNITED STATES'}</span><h1>{h1}</h1><p>{catalogPage?catalogPage.intro:article?article.intro:intro[id]}</p>{article && <div class="article-meta">{article.readTime} <span>·</span> {fr?'Par l’équipe IPTV USA 8K':'By the IPTV USA 8K team'} <span>·</span> <time datetime={site.updated}>{fr?'Mis à jour le ':'Updated '}{reviewedDate}</time></div>}</section>

  {id === 'plans' && <><Plans lang={lang}/><PlanComparison lang={lang}/><section class="wrap content-section">
    <div class="split-content section"><div><span class="eyebrow">{fr?'AVANT DE VOUS ABONNER':'BEFORE YOU SUBSCRIBE'}</span><h2>{fr?'Acheter un abonnement IPTV au United States : que vérifier?':'Before you buy IPTV in the United States: what to check.'}</h2><p>{fr?'Comparez ce que vous allez réellement utiliser, puis demandez le montant total et les conditions écrites.':'Compare what you will actually use, then ask for the total price and written terms.'}</p><a class="text-link" href={href('choose-iptv',lang)}>{fr?'Le guide pour bien choisir':'The guide to choosing well'} →</a></div><ul class="check-list">{(fr?['Le montant total en USD et les taxes applicables.','Le nombre exact de lectures simultanées.','Les chaînes et les langues qui vous intéressent.','Les frais éventuels du lecteur ou du matériel.','La durée, le renouvellement et les modalités de remboursement.']:['The full USD total and any applicable taxes.','The exact number of simultaneous streams.','The channels and languages you care about.','Any separate player or hardware charges.','The term, renewal method and refund conditions.']).map(s=><li>{s}</li>)}</ul></div>
  </section><TrialGenerator lang={lang}/></>}

  {id === 'devices' && <section class="wrap content-section"><DeviceChooser lang={lang}/><div class="split-content section"><div><h2>{fr?'Plusieurs appareils ≠ plusieurs écrans simultanés.':'More devices does not mean more simultaneous screens.'}</h2><p>{fr?'Installer un lecteur sur une télé et un téléphone ne change pas la limite de votre abonnement. Vérifiez le nombre de lectures autorisées avant de partager un compte.':'Installing a player on a television and phone does not change your subscription limit. Confirm the permitted stream count before sharing an account.'}</p></div><div class="notice"><h3>{fr?'Notez ces trois renseignements.':'Keep these three details handy.'}</h3><ol><li>{fr?'Modèle exact et version du système.':'Exact model and operating system version.'}</li><li>{fr?'Nom et version du lecteur proposé.':'Proposed player name and version.'}</li><li>{fr?'Type de connexion et nombre d’écrans.':'Connection type and number of screens.'}</li></ol><a class="text-link" href={href('contact',lang)}>{fr?'Préparer ma demande':'Prepare my enquiry'} →</a></div></div></section>}

  {id === 'guides' && <section class="wrap content-section guide-list">{guides.map((g,i)=><article><div class="guide-index">0{i+1}</div><div><span class="eyebrow">{g[lang].eyebrow} · {g[lang].readTime}</span><h2><a href={href(g.id,lang)}>{g[lang].heading}</a></h2><p>{g[lang].description}</p><a class="text-link" href={href(g.id,lang)}>{t.readGuide} ↗</a></div></article>)}</section>}

  {id === 'iptv-cost-usa' && <CostCalculator lang={lang}/>}
  {article && <div class="wrap article-layout"><aside class="toc"><p>{fr?'DANS CE GUIDE':'IN THIS GUIDE'}</p><nav aria-label={fr?'Sommaire':'Table of contents'}>{article.sections.map((s,i)=><a href={`#section-${i+1}`}>{s.heading}</a>)}</nav><a class="text-link" href={href('plans',lang)}>{t.cta} ↗</a></aside><article class="prose">{article.sections.map((s,i)=><section id={`section-${i+1}`}><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets && <ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}{guide.sources?.length>0 && <section class="sources"><h2>{fr?'Pour approfondir':'Further reading'}</h2><ul>{guide.sources.map(s=><li><a href={s.url}>{s.label} ↗</a></li>)}</ul></section>}<div class="article-next"><h2>{fr?'Passez de la lecture à votre installation.':'Put the guide to work in your home.'}</h2><p>{fr?'Vérifiez votre appareil, puis comparez les options qui correspondent à vos habitudes.':'Check your device, then compare the options that fit the way you watch.'}</p><a href={href('devices',lang)}>{t.secondary} →</a><a href={href('plans',lang)}>{t.cta} →</a><a href={generatorUrl(lang)} data-open-trial>{fr?'Générer mon essai IPTV gratuit':'Generate my free IPTV trial'} →</a></div></article></div>}

  {catalogPage && <CatalogPages id={id} lang={lang}/>}
  {id === 'trial' && <><TrialGenerator lang={lang}/><SevenDayTrial lang={lang}/><section class="wrap section trial-grid"><div class="trial-feature"><h2>{fr?'Votre essai IPTV, sur votre véritable installation':'Your IPTV trial, on your real home setup'}</h2><p>{fr?'Testez sur le même écran et le même réseau que vous utiliserez au quotidien. L’essai vous permet de vérifier les programmes disponibles, votre lecteur et la fluidité avant de choisir un abonnement.':'Test on the screen and network you will use every day. The trial lets you check the available programs, your player and playback before choosing a subscription.'}</p><p>{fr?'Pour le programme de sept jours, revenez après 24 heures pour générer la session suivante, jusqu’à sept sessions en 30 jours sur l’ensemble de nos sites. Vérifiez l’expiration de chaque accès dans votre lecteur. Le renouvellement est manuel; contactez WhatsApp en cas de difficulté.':'For the seven-day program, return after 24 hours to generate the next session, up to seven in 30 days across our websites. Check each session’s expiry in your player. Renewal is manual; contact WhatsApp support if you need help.'}</p><a class="text-link section-link" href={href('test-connection',lang)}>{fr?'Le guide complet pour tester IPTV':'The complete IPTV testing guide'} →</a></div><div class="trial-checks"><h2>{fr?'Votre liste de vérification':'Your trial checklist'}</h2>{(fr?['Utiliser votre télé et votre réseau habituels.','Regarder aux heures de forte utilisation à la maison.','Vérifier les chaînes et les langues souhaitées.','Tester les sous-titres, l’audio et le guide télé.','Confirmer la date d’expiration et les écrans autorisés.']:['Use your usual television and home network.','Watch during a busy evening in your household.','Check the channels and languages you want.','Test subtitles, audio tracks and the program guide.','Confirm the expiry date and permitted screen count.']).map((s,i)=><label><input type="checkbox"/><span><b>0{i+1}</b>{s}</span></label>)}</div></section></>}

  {id === 'contact' && <section class="wrap content-section"><div class="notice launch-note"><h2>{fr?'Besoin d’aide avec votre essai IPTV?':'Need help with your IPTV trial?'}</h2><p>{fr?'Le service d’activation partagé peut vous aider avec les identifiants et la configuration.':'Our shared activation support team can help with your trial credentials and setup.'}</p><a class="text-link section-link" href={generatorSupportUrl(lang)}>{fr?'Contacter l’assistance d’activation':'Contact activation support'} ↗</a></div><Contact lang={lang}/></section>}
  {id === 'faq' && <AnswerHub lang={lang}/>}

  {id === 'about' && <section class="wrap content-section about-grid"><img src="/images/iptv-usa-8k-dashboard.webp" width="1600" height="900" loading="lazy" alt={fr?'Paysage des Rocheuses canadiennes avec un canot rouge':'IPTV USA 8K promotional live TV and entertainment artwork'}/><div class="prose"><h2>{fr?'Pensé pour les téléspectateurs au United States.':'Built around American viewers.'}</h2><p>{fr?'IPTV USA 8K facilite le choix d’un abonnement IPTV au United States avec des pages en français et en anglais, un générateur d’essai, des guides d’appareils et des explications concrètes sur les connexions et les forfaits.':'IPTV USA 8K makes choosing an IPTV subscription in the United States easier through US-focused guides, a trial generator, device guides and practical explanations of connections and plans.'}</p><h2>{fr?'Une information qui aide à décider.':'Information that helps you decide.'}</h2><p>{fr?'Nos guides distinguent les capacités du lecteur, la connexion à domicile et les conditions de l’abonnement. Sélectionnez une durée et des écrans pour demander un devis en USD sur WhatsApp; l’équipe confirme la disponibilité et les modalités avant tout paiement.':'Our guides distinguish player capabilities, home connectivity and subscription terms. Select a duration and screen count to request a USD quote on WhatsApp; the team confirms availability and terms before any payment.'}</p><p>{fr?'IPTV USA 8K est la marque de ce site destiné au United States. Les demandes d’essai et d’assistance passent par notre équipe d’activation partagée. Son numéro WhatsApp international n’est pas présenté comme un numéro canadien. Demandez les coordonnées du vendeur et les conditions applicables avec votre devis.':'IPTV USA 8K is the brand of this website for the United States. Trial and support requests use our shared activation team. Its international WhatsApp number is not represented as a US number. Request the seller’s details and applicable sales terms with your quote.'}</p><h2>{fr?'Comment nous préparons les guides':'How we prepare the guides'}</h2><p>{fr?'Chaque guide répond à un besoin précis : budget, installation, réseau, écrans ou langue. Les conseils techniques s’appuient sur des références officielles lorsque c’est possible, avec des liens consultables dans le guide. Nous distinguons les fonctions du lecteur, les conditions du service et les éléments à confirmer pendant votre essai.':'Each guide addresses a specific need: budget, setup, network, screens or language. Technical advice uses official references where available, linked from the guide. We distinguish player features, service terms and the details you need to confirm during your trial.'}</p><p>{fr?'Les visuels sont promotionnels et les exemples de chaînes ne constituent pas une liste garantie. Les dates de révision sont affichées sur les guides; une nouvelle version d’application ou une modification d’offre peut nécessiter une nouvelle vérification.':'Artwork is promotional and named channels are not a guaranteed lineup. Review dates appear on the guides; a new app version or a changed offer may require another check.'}</p><a class="text-link" href={href('guides',lang)}>{t.allGuides} →</a></div></section>}

  {id === 'privacy' && <Privacy lang={lang}/>}

  {id === 'terms' && <article class="wrap prose legal-content"><h2>{fr?'Statut du site':'Website status'}</h2><p>{fr?'Ce site permet de demander un essai IPTV, de comparer des configurations et de contacter l’équipe partagée pour un devis en USD. Le choix d’une durée et d’un nombre d’écrans ouvre une demande WhatsApp; il n’active pas d’abonnement et ne prélève aucun paiement. Une offre payante nécessite une confirmation distincte de sa disponibilité, de son prix et de ses conditions.':'This website lets you request an IPTV trial, compare configurations and contact the shared team for a USD quote. Selecting a duration and screen count opens a WhatsApp request; it does not activate a subscription or collect payment. A paid offer requires separate confirmation of availability, price and terms.'}</p><h2>{fr?'Essai gratuit et activation':'Free trial and activation'}</h2><p>{fr?'Le programme d’essai de sept jours fonctionne par demandes quotidiennes auprès de notre service d’activation partagé. Revenez après 24 heures pour demander la session suivante, dans la limite de sept sessions en 30 jours commune à nos sites. Chaque accès a sa propre expiration, affichée dans le lecteur; il ne s’agit pas d’un identifiant donnant sept jours continus. La disponibilité et les contrôles anti-abus restent applicables. Aucun renouvellement automatique ni abonnement payant ne se crée. Contactez l’assistance WhatsApp en cas de difficulté.':'The seven-day trial program works through daily requests to our shared activation service. Return after 24 hours to request the next session, within the limit of seven sessions in 30 days shared across our websites. Each issued access has its own expiry, shown in the player; it is not one credential providing seven continuous days. Availability and abuse-prevention checks still apply. No automatic renewal or paid subscription is created. Contact WhatsApp support if you need help.'}</p><h2>{fr?'Guides et compatibilité':'Guides and compatibility'}</h2><p>{fr?'Les guides donnent des renseignements généraux pour préparer une installation. La compatibilité dépend du modèle, du système, du lecteur et du service choisi. Une mention de marque d’appareil n’implique aucune affiliation.':'The guides provide general information for planning a setup. Compatibility depends on the model, operating system, player and chosen service. Device brand mentions do not imply an affiliation.'}</p><h2>{fr?'Avant tout achat':'Before any purchase'}</h2><p>{fr?'Les prix en USD, les taxes applicables, les droits de diffusion, les chaînes, les connexions autorisées, le renouvellement et les conditions d’annulation ou de remboursement doivent être confirmés dans l’offre. Le site ne garantit pas l’accès à une chaîne ou à un événement particulier.':'USD pricing, applicable taxes, content distribution rights, channels, permitted connections, renewal and cancellation or refund conditions must be confirmed in the offer. This site does not guarantee access to a particular channel or event.'}</p><h2>{fr?'Utilisation du contenu':'Using the content'}</h2><p>{fr?'Les contenus éditoriaux et visuels présentent IPTV USA 8K et les usages IPTV au United States. Les images sont des illustrations, pas des captures d’une application ou une preuve de disponibilité de programmes. Les sites externes proposent leurs propres conditions.':'Editorial and visual content presents IPTV USA 8K and IPTV viewing in the United States. Images are illustrative, not screenshots of a service application or proof of program availability. External websites provide their own terms.'}</p><a href={href('contact',lang)}>{t.contact} →</a></article>}

  {article?.faq?.length>0 && <Faq items={article.faq} heading={t.faqHeading}/>}
  <section class="wrap related-section"><span class="eyebrow">{t.related}</span><div>{['plans','devices','trial','guides'].filter(key=>key!==id).map(key=><a href={href(key,lang)}>{{plans:t.nav[0],devices:t.nav[1],trial:fr?'Générer un essai gratuit':'Generate a free trial',guides:t.nav[2]}[key]}<span aria-hidden="true">↗</span></a>)}</div></section>
  <TopicLinks id={id} lang={lang}/>
</>}
</Base>
